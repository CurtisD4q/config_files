# Layout
anchor=top-right
margin=12
padding=10,14
width=350
height=110
border-size=2
border-radius=10
icons=1
max-icon-size=32
max-visible=8

# Font
font=Adwaita Sans 10

# Colours
background-color=#1a1820ee
text-color=#ffffffff
border-color=#851fd4ff

# Timeout
default-timeout=0

[urgency=low]
background-color=#1a1820ee
border-color=#908caaff
text-color=#908caaff

[urgency=normal]
background-color=#1a1820ee
border-color=#851fd4ff
text-color=#ffffffff

[urgency=critical]
background-color=#1a1820ee
border-color=#be185dff
text-color=#ffffffff
default-timeout=0
