# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Tiling layout
default_orientation horizontal

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left Left
set $down Down
set $up Up
set $right Right
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher 
set $menu fuzzel


include /etc/sway/config.d/* 


### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg /home/curtis/Pictures/wallpaper_purple3.jpg fill

#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

#Font 
font pango:Adwaita Sans Regular 12

### Idle configuration
#
# This is for when me screen goes into idle
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

exec ~/.config/sway/swayidle-media-wrap

bindsym $mod+Shift+l exec /usr/local/bin/gtklock -d

### Input configuration
#
# Example configuration:
#

input type:touchpad {
  dwt enabled
  tap enabled
  natural_scroll enabled
  middle_emulation enabled
}

input type:keyboard {
  xkb_layout "gb"
}


# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

#Gaps between windows
#gaps top 10
gaps inner 10
gaps outer 1
#gaps left 7
#gaps right 7
#gaps bottom 7
#gaps top 7

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    #bindsym $mod+d exec $menu
    bindsym $mod+d exec $menu --show drun

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    #Reload waybar
    bindsym $mod+Shift+r exec killall waybar; waybar

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec "~/.config/sway/power-menu.sh"

    #Toggle laptop display on/off when lid is closed
    bindswitch --reload --locked lid:on exec ~/.config/sway/sway-output-manager.sh --oneshot
    bindswitch --reload --locked lid:off exec ~/.config/sway/sway-output-manager.sh --oneshot
    exec ~/.config/sway/sway-output-manager.sh

    #Disable external monitor
    bindsym $mod+o exec ~/.config/sway/toggle-external-output.sh

    #Stop mouse from going to other screens whilst running fullscreen applications
    exec ~/.config/sway/sway-fullscreen-confine.sh
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right

#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10

    #switch workspaces with arrow keys
    bindsym $mod+Control+Left workspace prev
    bindsym $mod+Control+Right workspace next

    # Move focused container to workspace
    bindsym $mod+Shift+1 exec ~/.config/sway/move_window.sh 1
    bindsym $mod+Shift+2 exec ~/.config/sway/move_window.sh 2
    bindsym $mod+Shift+3 exec ~/.config/sway/move_window.sh 3
    bindsym $mod+Shift+4 exec ~/.config/sway/move_window.sh 4
    bindsym $mod+Shift+5 exec ~/.config/sway/move_window.sh 5
    bindsym $mod+Shift+6 exec ~/.config/sway/move_window.sh 6
    bindsym $mod+Shift+7 exec ~/.config/sway/move_window.sh 7
    bindsym $mod+Shift+8 exec ~/.config/sway/move_window.sh 8
    bindsym $mod+Shift+9 exec ~/.config/sway/move_window.sh 9
    bindsym $mod+Shift+0 exec ~/.config/sway/move_window.sh 10

    #move focused container to workspace with arrow keys
    bindsym $mod+Shift+Control+Left move container to workspace prev
    bindsym $mod+Shift+Control+Right move container to workspace next

    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+h or $mod+v, for horizontal and vertical splits
    # respectively.
    
    # mod+h and mod+v sets up the next window to either
    # vertical or horizontal
    bindsym $mod+h splith
    bindsym $mod+v splitv

    # mod+Shift+h changes all windows in the workspace to 
    # either verical or horizontal
    bindsym $mod+Shift+h layout splith 

    # Switch the current container between different layout styles
    #bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+Shift+t exec ~/.config/sway/toggle_tiling_gaps.sh

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen
    
    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle
    
    #launch the following applications in floating mode
    
    #Open all settings menus in floating mode
    for_window [app_id="^(general-settings|advanced-settings|settings-.*)$"] {
        floating enable
        resize set 900 600
        move position center
    }

    for_window [window_type="dialog"] floating enable
    for_window [window_type="utility"] floating enable
    for_window [window_type="toolbar"] floating enable
    for_window [window_type="splash"] floating enable
    for_window [window_type="menu"] floating enable
    for_window [window_type="popup_menu"] floating enable
    for_window [window_type="tooltip"] floating enable
    for_window [window_type="notification"] floating enable

    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad
    #bindsym $mod+Shift+plus exec ~/.config/sway/overview.sh

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus exec ~/.config/sway/scratchpad.sh next
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via PulseAudio
    bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
    bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
    
    # Special keys to adjust brightness via brightnessctl
    bindsym --locked XF86MonBrightnessDown exec /usr/local/bin/waybar-brightness-set.sh down
    bindsym --locked XF86MonBrightnessUp exec /usr/local/bin/waybar-brightness-set.sh up
    
    # Special key to take a screenshot with grim
    bindsym Print exec grim -g "$(slurp)" - | wl-copy
    bindsym Shift+Print exec grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# -----------------------------
# Window Borders (Monochrome + Neon Purple Outer)
# -----------------------------
# Format: client.<state> <border> <background> <text> <indicator>
# Border color = neon purple (#9B30FF)
# Background/text = monochrome grayscale

client.focused          #c9b2db #c9b2db #260940 #c9b2db #c9b2db
client.focused_inactive #260940 #260940 #CCCCCC #260940 #260940
client.unfocused        #260940 #260940 #CCCCCC #260940 #260940
client.urgent           #834842 #a45a52 #FFFFFF #be185d #a45a52

#Swayfx aesthetics 
for_window [app_id=".*"] border pixel 3

smart_corner_radius on
corner_radius 4
blur enable
shadows enable
shadow_blur_radius 20

